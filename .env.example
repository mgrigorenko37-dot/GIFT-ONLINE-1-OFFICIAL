# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for Express REST API & Socket.IO.
# In production, wildcard '*' is strictly forbidden and unlisted origins are blocked.
# In development/test, localhost and 127.0.0.1 origins are automatically allowed.
# Example: https://exchange.example.com,https://web.telegram.org,https://webk.telegram.org,https://webz.telegram.org
ALLOWED_ORIGINS=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Required for generating Telegram Stars invoice links.
# Get this from BotFather in Telegram.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# DATABASE_URL: Primary PostgreSQL connection string (Required for production).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Legacy discrete PostgreSQL configuration (Optional fallback for local development only if DATABASE_URL is not set):
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=secret
# SQL_DATABASE=gx_exchange

# REDIS_URL: Required for Socket.io Redis Adapter and multi-instance Pub/Sub scaling.
REDIS_URL=

# ALLOW_FILE_STORAGE_IN_PRODUCTION: Set to true only if file storage override is explicitly allowed.
ALLOW_FILE_STORAGE_IN_PRODUCTION=false

# TON_HOT_WALLET_MNEMONIC: Secret 24-word or 12-word recovery mnemonic for the exchange hot wallet (Withdrawals).
# Server-side only secret! NEVER expose to client or repository.
TON_HOT_WALLET_MNEMONIC=""

# TON_API_ENDPOINT: JSON-RPC or TON API endpoint (e.g., https://toncenter.com/api/v2/jsonRPC).
TON_API_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"

# TON_API_KEY: Optional API key for toncenter or tonapi rate limit expansion.
TON_API_KEY=""

# USE_MOCK_GIFTS: Set to "true" in development to seed deterministic mock gifts fixture.
# In PRODUCTION (NODE_ENV=production), this is strictly ignored and only PostgreSQL & TON API are used.
USE_MOCK_GIFTS=false

